# === 把這個檔案複製成 .env 後填入你自己的值 ===
# 注意：.env 含私鑰，絕對不要上傳 GitHub（.gitignore 已排除）
# Hardhat 3 透過 configVariable() 讀取這些變數（變數名稱需一致）

# Sepolia RPC 節點網址（從 Alchemy 或 Infura 取得；HW4 用過 Alchemy）
SEPOLIA_RPC_URL=

# 部署用測試帳號的私鑰（MetaMask → 帳戶詳情 → 匯出私鑰；該帳號需先有 Sepolia 測試幣）
SEPOLIA_PRIVATE_KEY=

# Etherscan API Key（etherscan.io 免費申請；用於驗證原始碼）
ETHERSCAN_API_KEY=
